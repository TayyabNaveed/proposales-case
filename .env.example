# Server-only values. Copy to .env.local; do not commit that local file.
PROPOSALES_API_KEY=
PROPOSALES_COMPANY_ID=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
TAVILY_API_KEY=
# Dedicated Supabase Postgres transaction-pooler URI, including database password.
DATABASE_URL=

# Local CA certificate downloaded from the Supabase dashboard.
DATABASE_CA_PATH=prod-ca-2021.crt
# On hosting, the PEM certificate can instead be supplied as DATABASE_CA_PEM.

# Exact browser origin for protected writes; set to deployment URL when hosting.
APP_ORIGIN=http://127.0.0.1:3001
REVIEWER_ACCESS_CODE=
SESSION_SECRET=
