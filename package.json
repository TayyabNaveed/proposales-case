{
  "name": "report-to-proposal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "probe": "node --import tsx scripts/probe-providers.ts",
    "db:migrate": "node --import tsx scripts/migrate.ts",
    "test:db": "node --import tsx --test tests/db.integration.ts tests/offers.integration.ts tests/access.integration.ts tests/provider-assets.integration.ts tests/recommendations.integration.ts tests/drafts.integration.ts tests/research.integration.ts tests/usage.integration.ts",
    "dev": "next dev --webpack --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "test:http": "node --import tsx --test tests/http.integration.ts",
    "format": "prettier --write src tests scripts next.config.ts"
  },
  "dependencies": {
    "@ai-sdk/deepseek": "3.0.63",
    "ai": "7.0.135",
    "next": "16.4.0",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prettier": "3.9.9",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
